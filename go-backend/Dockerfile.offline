# 曲泉AI Go 后端镜像 —— **离线构建版**（二进制在本地交叉编译好再传上来）
#
# 与 `Dockerfile` 的唯一区别：**这里没有 Go 构建阶段**。
# 二进制由本机（Windows）交叉编译好，随构建上下文一起上传：
#
#     cd go-backend
#     CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" \
#         -o colorai-backend-linux .
#
# 为什么要这样（2026-09-28）：
#   生产服务器 1.6GB 内存、**无 swap**。原 `Dockerfile` 要在服务器上
#   拉 `golang:1.25-alpine`(329MB) → `go mod download` → 编译，
#   这些都是**完全可避免**的内存与网络开销。
#   而 `CGO_ENABLED=0` 的产物是静态二进制，本来就与构建机无关，搬过去直接能用。
#
# 用哪个：`docker-compose.offline.yml` 会把本文件指定为构建用的 Dockerfile。
#   不叠加那个覆盖层时，compose 用的仍是原 `Dockerfile`（服务器本地构建那条路）。

FROM alpine:3.20

# ca-certificates：访问 DeepSeek / 阿里云 OSS 都走 HTTPS，缺根证书会直接 TLS 失败
# tzdata：日志时间戳要按本地时区
RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

# ⚠️ 文件名刻意带 `-linux` 后缀：`go-backend/.dockerignore` 里排除了 `colorai-backend`
#    （那是本机 Windows 编译出的同名产物），带后缀正好避开那条规则，不用改 .dockerignore。
COPY colorai-backend-linux /app/colorai-backend

# ⚠️ 必须显式 chmod +x。
#    打包上传走的是 tar，而 tar 归档时**统一把文件权限规范化成 0644**
#    （见 deploy/upload_backend.py 的 build_tarball），COPY 进来就是不可执行的，
#    CMD 会以 "permission denied" 失败。Windows 上没有可执行位，指望不上。
RUN chmod +x /app/colorai-backend

# local 驱动时的落盘目录，同时是 Gin 静态路由 /uploads 的映射目录。
# oss 驱动下不写入，但目录缺失只会 404、不会 panic —— 建出来是为了切回 local 时
# 不用重新打镜像（PUBLIC_BASE_URL 的语义会随驱动变，记得一并改）。
RUN mkdir -p /app/uploads

# 与 config/config.go 里 PORT 的默认值一致；实际端口以环境变量 PORT 为准
EXPOSE 3001

# ⚠️ .env 刻意不烘进镜像（见 .dockerignore），改由 compose 的 env_file 在运行时注入。
#    main.go 里的 godotenv.Load() 在容器里找不到 .env 会静默失败，
#    但 compose 已把变量写进进程环境，config.go 的 getEnv 读的就是 os.Getenv —— 两条路都通。
CMD ["/app/colorai-backend"]
