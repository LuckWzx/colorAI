# ColorAI Agent 环境变量配置

# 服务配置
APP_NAME=ColorAI Agent
APP_VERSION=1.0.0
DEBUG=true

# 服务器配置
HOST=0.0.0.0
AGENT_PORT=8000

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
# 旧的 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
DEEPSEEK_MODEL=deepseek-flash
# 思考模式开关（默认关闭，见 config.py 注释）
DEEPSEEK_THINKING=false

# 智能体配置
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096

# 图片校色服务（搭档提供的接口，见 doc/Color_Correction.md）
#
# 2026-09-24 确认：统一用 api.ququan.net（与 app/config.py 的代码默认值一致）。
# 历史文档里写的 api3.ququan.net 已全部改正 —— 两个域名解析到不同 IP，别混用。
CORRECTION_API_URL=https://api.ququan.net/quality/api/quality_check
CORRECTION_TIMEOUT=60.0
CORRECTION_RETRY=1
CORRECTION_DOWNLOAD_TIMEOUT=30.0

# CORS配置
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3001"]

# ---- RAG 知识库（不配 → 两个知识工具返回「知识库功能未启用」，对话与校色不受影响）----
# ⚠️ 这两组必须一起配：只配 EMBEDDING 不配 PG，或反之，都只会让知识库静默失效。
#
# 向量化：硅基流动 API，BGE-M3（1024 维）。独立于 DEEPSEEK_* —— 不同平台，绝不复用。
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 知识库 PostgreSQL（agent 私有，Go 侧不访问）
# PG_SCHEMA 必须是独立 schema —— 那是共享库，public 下有别人的表。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_DB=docmind
PG_SCHEMA=colorai_kb
# 公网连接别用 disable；同内网/本机可用 disable
PG_SSLMODE=require

# ---- 联网搜索（博查 Web Search API，https://open.bochaai.com；不配 → web_search 返回「未启用」）----
# httpx 直连、零新依赖。⚠️ 博查是预付费模式：403「not enough money」= 额度不足，需先充值。
WEB_SEARCH_ENABLED=true
SEARCH_API_KEY=your_bocha_api_key_here
# 以下键有代码默认值（app/config.py），需调整时取消注释：
# SEARCH_API_URL=https://api.bochaai.com/v1/web-search
# SEARCH_COUNT=5          # 每次返回条数
# SEARCH_MAX_COUNT=10     # 条数上限
# SEARCH_TIMEOUT=15.0     # 单次调用超时（秒）
# SEARCH_SNIPPET_MAX=500  # 单条摘要截断字符数
# SEARCH_RETRY=1          # 仅超时/5xx 重试次数

# ---- LangSmith 链路追踪（可选，不配则不上报）----
# 三条硬要求：
#   1. 变量名是 LANGSMITH_*，不是 LANGSMITCH_*（旧拼写 SDK 完全读不到）；
#   2. TRACING 的值必须是小写 true（True / 1 都不生效）；
#   3. PROJECT 填 project 的 **name**（如 colorAI），不是 UUID 形式的 id。
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=
