# Go 后端环境变量
# 复制为 .env 后填入实际值: cp .env.example .env

# 服务端口(默认 3001)
PORT=3001

# Python 智能体服务基地址（Go 通过它转发 /api/chat、探活 /health）
# ⚠️ 必须与 agent/.env 的 AGENT_PORT 保持一致，否则转发会失败。
# 本地默认 8000；若智能体跑在别的机器/容器里，改成对应地址。
AGENT_URL=http://localhost:8000

# 注意：LLM / 校色 / 知识库的密钥与地址**不在 Go 侧配置**。
# Go 只做转发（代理给 Python Agent），实际调用方是 Python：
#   - DeepSeek Key      → agent/.env 的 DEEPSEEK_API_KEY
#   - 校色服务地址      → agent/.env 的 CORRECTION_API_URL
#   - 知识库嵌入 Key    → agent/.env 的 EMBEDDING_API_KEY（硅基流动 BGE-M3）
#   - 知识库 PG 连接    → agent/.env 的 PG_*（PostgreSQL + pgvector，agent 私有）
# 以前这里的 LLM_API_KEY / COLOR_CORRECTION_API_URL 已废弃，删掉即可。

# === 图片存储 ===
# 存储驱动：local（默认，存本地磁盘）。后期接阿里云 OSS 时新增驱动。
STORAGE_DRIVER=local

# 本地存储根目录（同时是静态路由 /uploads 的映射目录）
UPLOADS_DIR=uploads

# 图片对外访问 URL 的前缀。**切 OSS 时只改这一个值**
# 本地：http://localhost:3001
# OSS： https://your-bucket.oss-cn-hangzhou.aliyuncs.com
PUBLIC_BASE_URL=http://localhost:3001

# 单张图片大小上限（字节），默认 10MB
MAX_UPLOAD_BYTES=10485760

# CORS 允许的额外来源(逗号分隔,可选)
# CORS_ORIGINS=https://your-domain.com

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# 数据库自动迁移（true/false，开发时开启可自动同步表结构）
DB_AUTO_MIGRATE=true

# Redis 配置(用于 session/token 存储)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=your_redis_password
